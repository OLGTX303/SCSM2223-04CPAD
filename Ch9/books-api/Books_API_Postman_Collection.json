{
  "info": {
    "name": "Books REST API - Slim 4 Lab",
    "description": "Postman collection for testing the Chapter 9 Books REST API. API routes require an Authorization header because Part G adds stub auth middleware.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "lab-token",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            ""
          ]
        },
        "description": "Expected: 200 OK with API name and version."
      }
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "List All Books",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/books",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "books"
              ]
            },
            "description": "Expected: 200 OK with count 4 and all seed books."
          }
        },
        {
          "name": "Search Books",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/books?q=clean",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "books"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "clean"
                }
              ]
            },
            "description": "Expected: 200 OK with matching books by title or author."
          }
        },
        {
          "name": "Limit Books",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/books?limit=2",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "books"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "2"
                }
              ]
            },
            "description": "Expected: 200 OK with two books."
          }
        },
        {
          "name": "Get Book By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/books/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "books",
                "1"
              ]
            },
            "description": "Expected: 200 OK with book id 1."
          }
        },
        {
          "name": "Get Book Not Found",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/books/999",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "books",
                "999"
              ]
            },
            "description": "Expected: 404 with Book 999 not found."
          }
        },
        {
          "name": "Create Book",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"JavaScript Everywhere\",\n  \"author\": \"Adam D. Scott\",\n  \"year\": 2020\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/books",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "books"
              ]
            },
            "description": "Expected: 201 Created with Location header. After adding the 4th seed book, the new book is usually /api/books/5 after server restart."
          }
        },
        {
          "name": "Create Book Validation Error",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Just a title\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/books",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "books"
              ]
            },
            "description": "Expected: 400 with author and year field errors."
          }
        },
        {
          "name": "Update Book",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"year\": 2009\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/books/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "books",
                "1"
              ]
            },
            "description": "Expected: 200 OK with updated year."
          }
        },
        {
          "name": "Delete Book",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/books/2",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "books",
                "2"
              ]
            },
            "description": "Expected: 200 OK with deleted book data."
          }
        }
      ]
    },
    {
      "name": "Middleware Checks",
      "item": [
        {
          "name": "Unauthorized API Request",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/books",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "books"
              ]
            },
            "description": "Expected: 401 because Authorization header is missing."
          }
        },
        {
          "name": "CORS Preflight",
          "request": {
            "method": "OPTIONS",
            "header": [
              {
                "key": "Origin",
                "value": "http://localhost:5173",
                "type": "text"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "POST",
                "type": "text"
              },
              {
                "key": "Access-Control-Request-Headers",
                "value": "Content-Type, Authorization",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/books",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "books"
              ]
            },
            "description": "Expected: 204 No Content with Access-Control-Allow-* headers."
          }
        }
      ]
    }
  ]
}
