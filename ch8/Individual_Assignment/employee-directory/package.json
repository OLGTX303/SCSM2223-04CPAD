    "start": "npm run dev"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "axios": "^1.16.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mysql2": "^3.22.3",
    "vite": "^8.0.12",
    "vue": "^3.5.34"
  },
  "devDependencies": {}
}
