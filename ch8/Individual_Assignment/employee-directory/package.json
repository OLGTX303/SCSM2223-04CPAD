{
  "name": "employee-directory",
  "version": "1.0.0",
  "private": true,
  "description": "Chapter 8 Employee Directory with Vue 3, Axios, Express and MySQL",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "vite --host 127.0.0.1 --port 5174 --strictPort",
